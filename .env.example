# Copie para .env apenas em máquina local. Nunca commite valores reais.
#
# Produção: EDUCAMAIS_ENV=production, EDUCAMAIS_SECRET_KEY obrigatória
# (mínimo 32 caracteres, não use chave de DEV/TESTE), PostgreSQL obrigatório,
# EDUCAMAIS_DEMO é ignorado, DEBUG permanece desligado, cookie Secure=True
# (exige HTTPS no proxy). Guia: documentacao/PRODUCAO.md

EDUCAMAIS_ENV=development
EDUCAMAIS_SECRET_KEY=
EDUCAMAIS_DEMO=0
EDUCAMAIS_DEBUG=0
EDUCAMAIS_PORT=5000
# FLASK_APP=app.py
# EDUCAMAIS_DATABASE_URI=sqlite:///instance/educamais.db
# EDUCAMAIS_DATABASE_URL=  # alias de EDUCAMAIS_DATABASE_URI (só se a URI estiver ausente)
# PostgreSQL (banco vazio via Alembic; não migra dados do SQLite):
# EDUCAMAIS_DATABASE_URI=postgresql+psycopg://usuario:senha@localhost:5432/educamais
# EDUCAMAIS_TEST_DATABASE_URI=postgresql+psycopg://usuario:senha@localhost:5432/educamais_pg_test
# Ensaio de migração de dados (banco descartável separado; NÃO reutilizar educamais_pg_test):
# EDUCAMAIS_MIGRACAO_TEST_DATABASE_URI=postgresql+psycopg://usuario:senha@localhost:5432/educamais_migracao_test
# Backup PostgreSQL (pg_dump/pg_restore). Não coloque senha na linha de comando.
# EDUCAMAIS_BACKUP_DIR=var/backups
# EDUCAMAIS_PG_BIN=  # diretório bin/ do PostgreSQL se pg_dump não estiver no PATH
# EDUCAMAIS_RESTORE_TEST_DATABASE_URI=postgresql+psycopg://usuario:senha@localhost:5432/educamais_restore_test
# Uploads privados (padrão instance/uploads). Não é pasta pública.
# EDUCAMAIS_UPLOAD_FOLDER=instance/uploads
# Lockout persistente (banco). Não usa Redis.
# EDUCAMAIS_LOGIN_MAX_TENTATIVAS=5
# EDUCAMAIS_LOGIN_BLOQUEIO_SEGUNDOS=300
# Logs operacionais (sem senha/token/SECRET_KEY/URI com senha).
# EDUCAMAIS_LOG_LEVEL=INFO
# EDUCAMAIS_LOG_FILE=
# EDUCAMAIS_LOG_MAX_BYTES=5242880
# EDUCAMAIS_LOG_BACKUP_COUNT=5
# Confiança em proxy: DESLIGADA por padrão. Não leia X-Forwarded-For sem ProxyFix.
# Só ative atrás de reverse proxy que reescreve os headers.
# EDUCAMAIS_PROXY_FIX=0
# EDUCAMAIS_TRUSTED_PROXY_COUNT=1
# Primeiro ano letivo cujos dados acadêmicos do histórico vêm do Educa+ (não de legado).
# EDUCAMAIS_ANO_INICIO_HISTORICO_AUTOMATICO=2026
# Produção WSGI (não use python app.py): python -m waitress --listen=127.0.0.1:8000 wsgi:app
